# AiPi-SCBB 发布构建配置
#
# 启用 6 个纯可移植模块（仅依赖 SDK 无关的 BL616 BSP 头文件），
# 可在 GitHub Actions 的 ubuntu/windows/macos 上直接编译。
# 其余模块（CH224A/SHT3x/HXD039B2/WS2812/ST7789V_LCD）依赖目标芯片
# SDK（STM32 HAL / bflb SDK / FreeRTOS），随源码包发布，由用户在目标平台构建。

CONFIG_SCBB_RELAY_ENABLED=y
CONFIG_SCBB_RELAY_GPIO_HEADER="bl616_bsp_gpio.h"
CONFIG_SCBB_RELAY_GPIO_PREFIX="bsp_gpio"
CONFIG_SCBB_RELAY_DELAY_HEADER="bl616_bsp_delay.h"
CONFIG_SCBB_RELAY_DELAY_PREFIX="bsp_delay"

CONFIG_SCBB_DHT11_ENABLED=y
CONFIG_SCBB_DHT11_GPIO_HEADER="bl616_bsp_gpio.h"
CONFIG_SCBB_DHT11_GPIO_PREFIX="bsp_gpio"
CONFIG_SCBB_DHT11_DELAY_HEADER="bl616_bsp_delay.h"
CONFIG_SCBB_DHT11_DELAY_PREFIX="bsp_delay"

CONFIG_SCBB_DS1302_ENABLED=y
CONFIG_SCBB_DS1302_GPIO_HEADER="bl616_bsp_gpio.h"
CONFIG_SCBB_DS1302_GPIO_PREFIX="bsp_gpio"
CONFIG_SCBB_DS1302_DELAY_HEADER="bl616_bsp_delay.h"
CONFIG_SCBB_DS1302_DELAY_PREFIX="bsp_delay"

CONFIG_SCBB_INA226_ENABLED=y
CONFIG_SCBB_INA226_I2C_HEADER="bl616_bsp_i2c.h"
CONFIG_SCBB_INA226_I2C_PREFIX="bsp_i2c"
CONFIG_SCBB_INA226_DELAY_HEADER="bl616_bsp_delay.h"
CONFIG_SCBB_INA226_DELAY_PREFIX="bsp_delay"

CONFIG_SCBB_OLED_096_SPI_ENABLED=y
CONFIG_SCBB_OLED_096_SPI_SPI_HEADER="bl616_bsp_spi.h"
CONFIG_SCBB_OLED_096_SPI_SPI_PREFIX="bsp_spi"
CONFIG_SCBB_OLED_096_SPI_GPIO_HEADER="bl616_bsp_gpio.h"
CONFIG_SCBB_OLED_096_SPI_GPIO_PREFIX="bsp_gpio"
CONFIG_SCBB_OLED_096_SPI_DELAY_HEADER="bl616_bsp_delay.h"
CONFIG_SCBB_OLED_096_SPI_DELAY_PREFIX="bsp_delay"

CONFIG_SCBB_RD03_V2_ENABLED=y
CONFIG_SCBB_RD03_V2_UART_HEADER="bl616_bsp_uart.h"
CONFIG_SCBB_RD03_V2_UART_PREFIX="bsp_uart"
CONFIG_SCBB_RD03_V2_DELAY_HEADER="bl616_bsp_delay.h"
CONFIG_SCBB_RD03_V2_DELAY_PREFIX="bsp_delay"

CONFIG_SCBB_CONFIG_HEADER_PATH="scbb_config.h"
