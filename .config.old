CONFIG_SCBB_LLCC68_ENABLED=y
CONFIG_SCBB_LLCC68_SPI_HEADER="stm32f10x_bsp_spi.h"
CONFIG_SCBB_LLCC68_SPI_PREFIX="bsp_spi"
CONFIG_SCBB_LLCC68_GPIO_HEADER="stm32f10x_bsp_gpio.h"
CONFIG_SCBB_LLCC68_GPIO_PREFIX="bsp_gpio"
CONFIG_SCBB_LLCC68_DELAY_HEADER="stm32f10x_delay.h"
CONFIG_SCBB_LLCC68_DELAY_PREFIX="delay"

#
# Output
#
CONFIG_SCBB_CONFIG_HEADER_PATH="scbb_config.h"
